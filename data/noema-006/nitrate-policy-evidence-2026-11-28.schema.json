{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AquaSignal nitrate health evidence and threshold provenance register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "study_id",
    "stream_id",
    "accessed_at",
    "evidence_items",
    "benchmarks",
    "synthesis",
    "unit_and_matrix_guards",
    "limitations",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "const": "AQUASIGNAL-NITRATE-EVIDENCE-THRESHOLD-PROVENANCE-2026-11-28"
    },
    "study_id": {
      "const": "NOEMA-2026-013"
    },
    "stream_id": {
      "const": "NOEMA-2026-006"
    },
    "accessed_at": {
      "const": "2026-11-28",
      "format": "date"
    },
    "evidence_items": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "evidence_class",
          "source_type",
          "publisher",
          "title",
          "publication_date",
          "url",
          "reproduction_status",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 8
          },
          "evidence_class": {
            "const": "FACT"
          },
          "source_type": {
            "type": "string",
            "minLength": 5
          },
          "publisher": {
            "type": "string",
            "minLength": 3
          },
          "title": {
            "type": "string",
            "minLength": 12
          },
          "publication_date": {
            "type": "string",
            "format": "date"
          },
          "article_date": {
            "type": "string",
            "format": "date"
          },
          "assessment_date": {
            "type": "string",
            "pattern": "^\\d{4}$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "doi": {
            "type": "string",
            "pattern": "^10\\."
          },
          "authors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "matrix": {
            "const": "drinking_water"
          },
          "analyte": {
            "const": "nitrate"
          },
          "native_value": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "native_unit": {
            "const": "mg/L"
          },
          "native_basis": {
            "enum": [
              "NO3",
              "NO3-N"
            ]
          },
          "sample_size": {
            "type": "integer",
            "minimum": 1
          },
          "study_design": {
            "type": "string"
          },
          "reported_results": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "reproduction_status": {
            "type": "string",
            "minLength": 8
          },
          "note": {
            "type": "string",
            "minLength": 30
          }
        }
      }
    },
    "benchmarks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "benchmark_id",
          "kind",
          "value",
          "unit",
          "basis",
          "matrix",
          "status",
          "publication_date",
          "source_url",
          "scope_note"
        ],
        "properties": {
          "benchmark_id": {
            "type": "string",
            "minLength": 8
          },
          "kind": {
            "enum": [
              "international_guideline",
              "national_regulation",
              "expert_recommendation"
            ]
          },
          "value": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "unit": {
            "const": "mg/L"
          },
          "basis": {
            "const": "NO3"
          },
          "matrix": {
            "const": "drinking_water"
          },
          "status": {
            "enum": [
              "guidance_only",
              "regulatory_scope_review_required",
              "recommendation_only"
            ]
          },
          "publication_date": {
            "type": "string",
            "format": "date"
          },
          "assessment_date": {
            "type": "string",
            "pattern": "^\\d{4}$"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "scope_note": {
            "type": "string",
            "minLength": 40
          }
        }
      }
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "FACT",
        "REPRODUCED_RESULT",
        "INFERENCE",
        "HYPOTHESIS",
        "UNTESTED_IDEA"
      ],
      "properties": {
        "FACT": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 40
          }
        },
        "REPRODUCED_RESULT": {
          "type": "array",
          "maxItems": 0
        },
        "INFERENCE": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 40
          }
        },
        "HYPOTHESIS": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 40
          }
        },
        "UNTESTED_IDEA": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 40
          }
        }
      }
    },
    "unit_and_matrix_guards": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "minLength": 30
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 30
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_sample_records_included",
        "sample_identifiers_included",
        "personal_data_included",
        "exact_site_coordinates_included",
        "private_well_register_data_included"
      ],
      "properties": {
        "raw_sample_records_included": {
          "const": false
        },
        "sample_identifiers_included": {
          "const": false
        },
        "personal_data_included": {
          "const": false
        },
        "exact_site_coordinates_included": {
          "const": false
        },
        "private_well_register_data_included": {
          "const": false
        }
      }
    }
  }
}
