{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Georgia drinking-water monitoring frame and disclosure evidence snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "snapshot_date",
    "evidence_boundary",
    "sources",
    "observations",
    "source_access",
    "disclosure_findings",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "const": "NOEMA-2026-006"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "evidence_boundary": {
      "type": "string",
      "minLength": 20
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "authority",
          "title",
          "url",
          "publication_date",
          "accessed_at",
          "source_type",
          "evidence_note"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 3
          },
          "authority": {
            "type": "string",
            "minLength": 3
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "publication_date": {
            "type": "string",
            "format": "date"
          },
          "accessed_at": {
            "type": "string",
            "format": "date"
          },
          "source_type": {
            "enum": [
              "official_agency_release",
              "official_human_rights_oversight_report",
              "journal_secondary_analysis"
            ]
          },
          "evidence_note": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "source_id",
              "observation_kind",
              "period",
              "matrix_scope",
              "sample_count_lower_bound",
              "count_relation",
              "non_compliances",
              "reported_rate_percent",
              "exact_denominator",
              "rate_is_water_only"
            ],
            "properties": {
              "observation_id": {
                "type": "string"
              },
              "source_id": {
                "type": "string"
              },
              "observation_kind": {
                "const": "actual_reported_combined_summary"
              },
              "period": {
                "type": "string",
                "pattern": "^20[0-9]{2}$"
              },
              "matrix_scope": {
                "const": "food_and_drinking_water_combined"
              },
              "sample_count_lower_bound": {
                "type": "integer",
                "minimum": 1
              },
              "count_relation": {
                "const": "greater_than"
              },
              "non_compliances": {
                "type": "integer",
                "minimum": 0
              },
              "reported_rate_percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "exact_denominator": {
                "type": "null"
              },
              "rate_is_water_only": {
                "const": false
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "source_id",
              "observation_kind",
              "period",
              "matrix_scope",
              "planned_sample_count",
              "includes_packaged_water"
            ],
            "properties": {
              "observation_id": {
                "type": "string"
              },
              "source_id": {
                "type": "string"
              },
              "observation_kind": {
                "const": "planned_sample_allocation"
              },
              "period": {
                "type": "string",
                "pattern": "^20[0-9]{2}$"
              },
              "matrix_scope": {
                "const": "drinking_water_including_packaged"
              },
              "planned_sample_count": {
                "type": "integer",
                "minimum": 1
              },
              "includes_packaged_water": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "source_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "page_publication_date",
        "accessed_at",
        "linked_2023_workbook_mime_type",
        "retrieval_status",
        "raw_bytes_obtained",
        "sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "page_publication_date": {
          "type": "null"
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "linked_2023_workbook_mime_type": {
          "const": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        },
        "retrieval_status": {
          "const": "reader_rejected_unsupported_xlsx"
        },
        "raw_bytes_obtained": {
          "const": false
        },
        "sha256": {
          "type": "null"
        }
      }
    },
    "disclosure_findings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 20
      }
    }
  }
}
