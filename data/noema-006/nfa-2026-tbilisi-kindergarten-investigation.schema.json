{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AquaSignal metadata-only NFA 2026 Tbilisi kindergarten investigation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "evidence_status",
    "investigation",
    "source",
    "privacy",
    "interpretation_limits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "const": "NOEMA-2026-006"
    },
    "evidence_status": {
      "const": "FACT"
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_date",
        "location_scope",
        "context",
        "facilities_inspected_approx",
        "combined_food_and_drinking_water_samples_collected",
        "food_samples_tested",
        "food_samples_noncompliant",
        "water_samples_collected",
        "water_samples_tested",
        "water_sample_results",
        "remaining_combined_investigation_results"
      ],
      "properties": {
        "publication_date": {
          "const": "2026-09-25"
        },
        "location_scope": {
          "const": "Tbilisi"
        },
        "context": {
          "type": "string",
          "minLength": 30
        },
        "facilities_inspected_approx": {
          "const": 70
        },
        "combined_food_and_drinking_water_samples_collected": {
          "const": 694
        },
        "food_samples_tested": {
          "const": 129
        },
        "food_samples_noncompliant": {
          "const": 0
        },
        "water_samples_collected": {
          "type": "null"
        },
        "water_samples_tested": {
          "type": "null"
        },
        "water_sample_results": {
          "type": "null"
        },
        "remaining_combined_investigation_results": {
          "const": "reported_as_pending_at_publication"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher",
        "title",
        "publication_date",
        "url",
        "accessed_at"
      ],
      "properties": {
        "publisher": {
          "const": "National Food Agency of Georgia"
        },
        "title": {
          "const": "No violations found in 129 food samples taken from kindergartens"
        },
        "publication_date": {
          "const": "2026-09-25"
        },
        "url": {
          "const": "https://www.nfa.gov.ge/en/News/Details/3868"
        },
        "accessed_at": {
          "const": "2026-11-27"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_level_data_included",
        "kindergarten_names_included",
        "personal_data_included",
        "exact_addresses_included"
      ],
      "properties": {
        "child_level_data_included": {
          "const": false
        },
        "kindergarten_names_included": {
          "const": false
        },
        "personal_data_included": {
          "const": false
        },
        "exact_addresses_included": {
          "const": false
        }
      }
    },
    "interpretation_limits": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 30
      }
    }
  }
}
