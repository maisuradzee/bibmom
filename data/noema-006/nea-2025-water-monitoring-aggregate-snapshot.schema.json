{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEA 2025 groundwater and surface-water aggregate snapshot with matrix-separated coverage",
  "description": "Source-reported aggregate counts only. Groundwater and surface-water frames are distinct. No sample-level results, coordinates, private identifiers, unique-site claim, prevalence or compliance estimate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "snapshot_date",
    "source",
    "groundwater",
    "surface_water",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "const": "NOEMA-2026-006"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "url",
        "report_year",
        "locator",
        "accessed_at",
        "file_sha256",
        "file_sha256_status"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "publisher": {
          "const": "National Environmental Agency of Georgia"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://nea.gov.ge/"
        },
        "report_year": {
          "const": 2025
        },
        "locator": {
          "type": "string",
          "minLength": 5,
          "maxLength": 512
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "file_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "file_sha256_status": {
          "const": "NOT_COMPUTED"
        }
      }
    },
    "groundwater": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_reported_total_points",
        "routine_hydrogeological_monitoring_points",
        "field_instrumental_study_points",
        "unique_site_count",
        "automatic_stations_added",
        "online_monitoring_software_updated",
        "laboratory_sampling_points",
        "laboratory_sample_count",
        "reported_sample_counts_by_analysis_group",
        "regional_lab_sample_counts",
        "nitrate_field_study_points",
        "overlap_assessment"
      ],
      "properties": {
        "source_reported_total_points": {
          "type": "integer",
          "minimum": 0
        },
        "routine_hydrogeological_monitoring_points": {
          "type": "integer",
          "minimum": 0
        },
        "field_instrumental_study_points": {
          "type": "integer",
          "minimum": 0
        },
        "unique_site_count": {
          "type": "null"
        },
        "automatic_stations_added": {
          "type": "integer",
          "minimum": 0
        },
        "online_monitoring_software_updated": {
          "type": "boolean"
        },
        "laboratory_sampling_points": {
          "type": "integer",
          "minimum": 0
        },
        "laboratory_sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "reported_sample_counts_by_analysis_group": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chemical",
            "microbiological",
            "heavy_metals",
            "petroleum_products",
            "pesticides"
          ],
          "properties": {
            "chemical": {
              "type": "integer",
              "minimum": 0
            },
            "microbiological": {
              "type": "integer",
              "minimum": 0
            },
            "heavy_metals": {
              "type": "integer",
              "minimum": 0
            },
            "petroleum_products": {
              "type": "integer",
              "minimum": 0
            },
            "pesticides": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "regional_lab_sample_counts": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "region_code",
              "region_ka",
              "region_en",
              "chemical",
              "microbiological",
              "heavy_metals",
              "petroleum_products",
              "pesticides",
              "total"
            ],
            "properties": {
              "region_code": {
                "type": "string",
                "pattern": "^[A-Z_]+$"
              },
              "region_ka": {
                "type": "string",
                "minLength": 2
              },
              "region_en": {
                "type": "string",
                "minLength": 2
              },
              "chemical": {
                "type": "integer",
                "minimum": 0
              },
              "microbiological": {
                "type": "integer",
                "minimum": 0
              },
              "heavy_metals": {
                "type": "integer",
                "minimum": 0
              },
              "petroleum_products": {
                "type": "integer",
                "minimum": 0
              },
              "pesticides": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "nitrate_field_study_points": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "boreholes",
            "springs",
            "household_wells",
            "source_term_household_well",
            "household_well_translation",
            "regional_counts",
            "concentration_results_published",
            "laboratory_confirmation_published",
            "final_vulnerable_zone_designation_in_this_report"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "boreholes": {
              "type": "integer",
              "minimum": 0
            },
            "springs": {
              "type": "integer",
              "minimum": 0
            },
            "regional_counts": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "region_code",
                  "region_ka",
                  "region_en",
                  "springs",
                  "boreholes",
                  "household_wells",
                  "total"
                ],
                "properties": {
                  "region_code": {
                    "type": "string",
                    "pattern": "^[A-Z_]+$"
                  },
                  "region_ka": {
                    "type": "string",
                    "minLength": 2
                  },
                  "region_en": {
                    "type": "string",
                    "minLength": 2
                  },
                  "springs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "boreholes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "household_wells": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "concentration_results_published": {
              "const": false
            },
            "laboratory_confirmation_published": {
              "const": false
            },
            "final_vulnerable_zone_designation_in_this_report": {
              "const": false
            },
            "household_wells": {
              "type": "integer",
              "minimum": 0
            },
            "source_term_household_well": {
              "const": "საყოფაცხოვრებო ჭა"
            },
            "household_well_translation": {
              "const": "household well"
            }
          }
        },
        "overlap_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unique_site_count_status",
            "groundwater_lab_vs_surface_water_parameter_coverage",
            "routine_vs_field_site_overlap",
            "nitrate_vs_field_instrumental_point_identity"
          ],
          "properties": {
            "unique_site_count_status": {
              "const": "not_reported"
            },
            "routine_vs_field_site_overlap": {
              "const": "not_verifiable_from_public_aggregate"
            },
            "nitrate_vs_field_instrumental_point_identity": {
              "const": "not_linked_by_public_site_ids"
            },
            "groundwater_lab_vs_surface_water_parameter_coverage": {
              "const": "not_comparable_different_matrix"
            }
          }
        }
      }
    },
    "surface_water": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampling_points",
        "sample_count",
        "matrix_separation_note",
        "parameter_coverage_points",
        "parameter_coverage_scope"
      ],
      "properties": {
        "sampling_points": {
          "type": "integer",
          "minimum": 0
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "matrix_separation_note": {
          "type": "string",
          "minLength": 20
        },
        "parameter_coverage_points": {
          "type": "integer",
          "minimum": 0
        },
        "parameter_coverage_scope": {
          "const": "surface_water_only"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  }
}
