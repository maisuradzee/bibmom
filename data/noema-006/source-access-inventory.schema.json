{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AquaSignal source access inventory",
  "description": "Public-source metadata only. It records availability and reuse verification status, not raw water-quality observations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_on",
    "evidence_boundary",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "evidence_boundary": {
      "type": "string",
      "minLength": 20
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "publisher",
          "publication_date",
          "url",
          "matrix",
          "access_status",
          "observation_period",
          "sample_level_schema_verified",
          "reuse_terms_verified",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,64}$"
          },
          "publisher": {
            "type": "string",
            "minLength": 2
          },
          "publication_date": {
            "type": "string",
            "pattern": "^(undated|[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?)$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "matrix": {
            "enum": [
              "groundwater",
              "surface_water",
              "potable_network",
              "surface_and_groundwater",
              "water_quality_station_registry",
              "groundwater_well_registry"
            ]
          },
          "access_status": {
            "enum": [
              "official_report_archive_linked_not_extracted",
              "public_pdf_aggregate_and_process_facts",
              "public_pdf_aggregate_only_denominator_not_in_table",
              "public_historical_aggregate_table",
              "public_map_and_table_entry_not_inspected",
              "official_regulation_only_registry_access_unverified",
              "public_catalog_metadata_payload_not_retrieved",
              "official_field_process_notice_only",
              "official_legal_data_access_framework",
              "public_bulletin_listing_payload_not_retrieved"
            ]
          },
          "observation_period": {
            "type": "string",
            "minLength": 2
          },
          "sample_level_schema_verified": {
            "type": "boolean"
          },
          "reuse_terms_verified": {
            "type": "boolean"
          },
          "reported_counts": {
            "type": "object",
            "patternProperties": {
              "^[a-z0-9_]+$": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "note": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
