{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AquaSignal metadata-only NEA 2021-2025 groundwater report access lead",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "study_id",
    "evidence_status",
    "source",
    "report_scope",
    "regulatory_context",
    "interpretation_limits",
    "privacy",
    "external_drinking_water_guideline"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "const": "AQUASIGNAL-NEA-GW-2021-2025"
    },
    "study_id": {
      "const": "NOEMA-2026-006"
    },
    "evidence_status": {
      "const": "FACT"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher",
        "title_ka",
        "title_en",
        "announcement_url",
        "announcement_date",
        "archive_url",
        "archive_format",
        "archive_retrieval_status",
        "archive_sha256",
        "archive_contents_inspected",
        "reuse_terms_status",
        "accessed_at"
      ],
      "properties": {
        "publisher": {
          "const": "National Environmental Agency of Georgia"
        },
        "title_ka": {
          "type": "string",
          "minLength": 30
        },
        "title_en": {
          "type": "string",
          "minLength": 30
        },
        "announcement_url": {
          "const": "https://www.nea.gov.ge/Ge/News/3461"
        },
        "announcement_date": {
          "const": "2026-11-26"
        },
        "archive_url": {
          "type": "string",
          "format": "uri"
        },
        "archive_format": {
          "const": "RAR"
        },
        "archive_retrieval_status": {
          "const": "not_retrieved"
        },
        "archive_sha256": {
          "type": "null"
        },
        "archive_contents_inspected": {
          "const": false
        },
        "reuse_terms_status": {
          "const": "not_stated_in_announcement"
        },
        "accessed_at": {
          "const": "2026-11-28"
        }
      }
    },
    "report_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_start_year",
        "coverage_end_year",
        "monitoring_domain",
        "announced_components",
        "field_methodology_title_ka",
        "field_methodology_focus",
        "sample_count",
        "station_count",
        "analyte_denominators",
        "result_rows",
        "site_coordinates",
        "time_series_rows",
        "archive_contents_inspected"
