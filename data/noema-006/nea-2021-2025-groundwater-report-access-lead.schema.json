      "properties": {
        "coverage_start_year": {
          "const": 2021
        },
        "coverage_end_year": {
          "const": 2025
        },
        "monitoring_domain": {
          "const": "groundwater_fresh_drinking_water"
        },
        "announced_components": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "field_methodology_title_ka": {
          "type": "string",
          "minLength": 20
        },
        "field_methodology_focus": {
          "type": "string",
          "minLength": 30
        },
        "sample_count": {
          "type": "null"
        },
        "station_count": {
          "type": "null"
        },
        "analyte_denominators": {
          "type": "null"
        },
        "result_rows": {
          "type": "null"
        },
        "site_coordinates": {
          "type": "null"
        },
        "time_series_rows": {
          "type": "null"
        },
        "archive_contents_inspected": {
          "const": false
        }
      }
    },
    "regulatory_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher",
        "law_title_ka",
        "law_url",
        "law_date",
        "groundwater_nitrate_risk_zone_identification_due",
        "relevant_methodology_approval_due",
        "approval_or_completion_verified"
      ],
      "properties": {
        "publisher": {
          "const": "Legislative Herald of Georgia"
        },
        "law_title_ka": {
          "type": "string",
          "minLength": 20
        },
        "law_url": {
          "const": "https://manage.matsne.gov.ge/ka/document/view/6904700"
        },
        "law_date": {
          "const": "2026-06-24"
        },
        "groundwater_nitrate_risk_zone_identification_due": {
          "const": "2027-09-01"
        },
        "relevant_methodology_approval_due": {
          "const": "2027-09-01"
        },
        "approval_or_completion_verified": {
          "const": false
        }
      }
    },
    "interpretation_limits": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string",
        "minLength": 40
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "personal_data_included",
        "business_identifiers_included",
        "exact_site_coordinates_included",
        "raw_sample_records_included",
        "restricted_archive_bytes_included"
      ],
      "properties": {
        "personal_data_included": {
          "const": false
        },
        "business_identifiers_included": {
          "const": false
        },
        "exact_site_coordinates_included": {
          "const": false
        },
        "raw_sample_records_included": {
          "const": false
        },
        "restricted_archive_bytes_included": {
          "const": false
        }
      }
    },
    "external_drinking_water_guideline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher",
        "edition_title",
        "edition_date",
        "publication_url",
        "chemical_fact_sheet_pdf_url",
        "nitrate_guideline_value_mg_per_l",
        "nitrate_basis",
        "nitrite_guideline_value_mg_per_l",
        "nitrite_basis",
        "combined_ratio_limit",
        "combined_ratio_formula",
        "nitrate_to_nitrate_nitrogen_conversion_factor",
        "nitrite_to_nitrite_nitrogen_conversion_factor",
        "applies_to",
        "most_sensitive_population",
        "fact_sheet_assessment_date",
        "not_georgian_legal_limit",
        "not_automatically_applicable_to_raw_groundwater",
        "interpretation"
      ],
      "properties": {
        "publisher": {
          "const": "World Health Organization"
        },
        "edition_title": {
          "type": "string",
          "minLength": 30
        },
        "edition_date": {
          "const": "2026-06-17"
        },
        "publication_url": {
          "const": "https://www.who.int/publications/i/item/9789240121225"
        },
        "chemical_fact_sheet_pdf_url": {
          "const": "https://cdn.who.int/media/docs/default-source/wash-documents/water-safety-and-quality/dwq-guidelines-4/gdwq_4ed_with_third-addenda_chemical-fact-sheets.pdf"
        },
        "nitrate_guideline_value_mg_per_l": {
          "const": 50
        },
        "nitrate_basis": {
          "const": "as nitrate ion"
        },
        "nitrite_guideline_value_mg_per_l": {
          "const": 3
        },
        "nitrite_basis": {
          "const": "as nitrite ion"
        },
        "combined_ratio_limit": {
          "const": 1
        },
        "combined_ratio_formula": {
          "const": "C_nitrate/GV_nitrate + C_nitrite/GV_nitrite <= 1"
        },
        "nitrate_to_nitrate_nitrogen_conversion_factor": {
          "const": 0.226
        },
        "nitrite_to_nitrite_nitrogen_conversion_factor": {
          "const": 0.304
        },
        "applies_to": {
          "const": "drinking-water"
        },
        "most_sensitive_population": {
          "const": "bottle-fed infants"
        },
        "fact_sheet_assessment_date": {
          "const": 2016
        },
        "not_georgian_legal_limit": {
          "const": true
        },
        "not_automatically_applicable_to_raw_groundwater": {
          "const": true
        },
        "interpretation": {
          "type": "string",
          "minLength": 40
        }
      }
    }
