{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AquaSignal groundwater quantitative-readiness evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "research_id",
    "as_of",
    "evidence_status",
    "primary_legal_basis",
    "secondary_annex_transcription",
    "design_contract",
    "limitations"
  ],
  "properties": {
    "record_id": {
      "const": "AQUASIGNAL-GW-QUANT-READINESS-2026-11-28"
    },
    "research_id": {
      "const": "NOEMA-2026-011"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "evidence_status": {
      "const": "PRELIMINARY_ARCHITECTURE"
    },
    "primary_legal_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "publication_date",
        "url",
        "accessed_at",
        "articles"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 5
        },
        "publisher": {
          "type": "string",
          "minLength": 2
        },
        "publication_date": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "articles": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "article",
              "evidence_class",
              "statement"
            ],
            "properties": {
              "article": {
                "type": "string"
              },
              "evidence_class": {
                "const": "FACT"
              },
              "statement": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        }
      }
    },
    "secondary_annex_transcription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_class",
        "title",
        "publisher",
        "publication_date",
        "url",
        "accessed_at",
        "official_attachment",
        "observations"
      ],
      "properties": {
        "evidence_class": {
          "const": "SECONDARY_TRANSCRIPTION_ONLY"
        },
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "publication_date": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "official_attachment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publisher",
            "filename",
            "byte_length",
            "mime_type",
            "url",
            "retrieval_status",
            "sha256"
          ],
          "properties": {
            "publisher": {
              "type": "string"
            },
            "filename": {
              "type": "string"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 1
            },
            "mime_type": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "retrieval_status": {
              "const": "NOT_RETRIEVED"
            },
            "sha256": {
              "type": [
                "null",
                "string"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "annex",
              "table",
              "topic",
              "transcription",
              "caution"
            ],
            "properties": {
              "annex": {
                "type": "string"
              },
              "table": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              },
              "transcription": {
                "type": "string"
              },
              "caution": {
                "const": "Secondary transcription only; not verified against the official DOCX."
              }
            }
          }
        }
      }
    },
    "design_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_before_designation",
        "scope_after_designation",
        "quantitative_status_gate",
        "prerequisite_success_semantics",
        "assigns_good_or_poor_status",
        "requires_authority_review",
        "stores_abstraction_volumes",
        "stores_personal_or_private_well_data"
      ],
      "properties": {
        "scope_before_designation": {
          "const": "hydrogeological_unit"
        },
        "scope_after_designation": {
          "const": "groundwater_body"
        },
        "quantitative_status_gate": {
          "type": "string"
        },
        "prerequisite_success_semantics": {
          "const": "PREREQUISITES_MET_REQUIRES_AUTHORITY_ASSESSMENT"
        },
        "assigns_good_or_poor_status": {
          "const": false
        },
        "requires_authority_review": {
          "const": true
        },
        "stores_abstraction_volumes": {
          "const": false
        },
        "stores_personal_or_private_well_data": {
          "const": false
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  }
}
