{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AquaSignal public-information gap evidence snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "finding_id",
    "snapshot_date",
    "evidence_boundary",
    "sources",
    "findings",
    "design_requirements",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "const": "NOEMA-2026-006"
    },
    "finding_id": {
      "const": "AQUASIGNAL-PUBLIC-INFORMATION-001"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "evidence_boundary": {
      "type": "string",
      "minLength": 40
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "publisher",
          "publication_date",
          "url",
          "source_type",
          "access_date",
          "locators",
          "provenance_note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 10
          },
          "publisher": {
            "type": "string",
            "minLength": 3
          },
          "publication_date": {
            "type": "string",
            "minLength": 4
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source_type": {
            "type": "string",
            "minLength": 5
          },
          "access_date": {
            "type": "string",
            "format": "date"
          },
          "locators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "provenance_note": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "statement",
          "source_ids",
          "locator",
          "limitation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[FIHU]-[0-9]{3}$"
          },
          "status": {
            "enum": [
              "FACT",
              "REPRODUCED_RESULT",
              "INFERENCE",
              "HYPOTHESIS",
              "UNTESTED_IDEA"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 20
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "locator": {
            "type": "string",
            "minLength": 3
          },
          "limitation": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "design_requirements": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement",
          "rationale",
          "privacy_boundary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R-[0-9]{3}$"
          },
          "requirement": {
            "type": "string",
            "minLength": 20
          },
          "rationale": {
            "type": "string",
            "minLength": 10
          },
          "privacy_boundary": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  }
}
