{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AquaSignal Georgian drinking-water monitoring control-point crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "study_id",
    "evidence_status",
    "source",
    "scope",
    "sampling_points",
    "supplier_obligations",
    "routine_monitoring",
    "repeat_sampling",
    "emergency_monitoring",
    "independent_testing",
    "transition_note",
    "interpretation_limits",
    "privacy",
    "legal_transition_review_required",
    "sampling_frequency_requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "const": "AQUASIGNAL-GEORGIAN-DRINKING-WATER-CONTROLS-2026-11-28"
    },
    "study_id": {
      "const": "NOEMA-2026-006"
    },
    "evidence_status": {
      "const": "FACT"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher",
        "document_title",
        "date",
        "url",
        "checked_at",
        "articles"
      ],
      "properties": {
        "publisher": {
          "const": "Legislative Herald of Georgia"
        },
        "document_title": {
          "type": "string",
          "minLength": 30
        },
        "date": {
          "const": "2014-01-15"
        },
        "url": {
          "const": "https://matsne.gov.ge/ka/document/view/2196792"
        },
        "checked_at": {
          "const": "2026-11-28"
        },
        "articles": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "1(2)",
              "1(3)",
              "1(5)",
              "1(6)",
              "1(7)",
              "3(4)",
              "3(6)",
              "3(9)",
              "4(2)",
              "3(2)",
              "3(3)"
            ]
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "exclusions",
        "raw_groundwater_automatic_compliance"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 50
        },
        "exclusions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 20
          }
        },
        "raw_groundwater_automatic_compliance": {
          "const": false
        }
      }
    },
    "sampling_points": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "supply_mode",
          "sampling_point",
          "article"
        ],
        "properties": {
          "supply_mode": {
            "type": "string",
            "enum": [
              "distribution_system",
              "tank_or_cistern",
              "bottled_or_container",
              "food_production"
            ]
          },
          "sampling_point": {
            "type": "string",
            "minLength": 25
          },
          "article": {
            "type": "string",
            "pattern": "^1\\(5\\)\\([a-d]\\)$"
          }
        }
      }
    },
    "supplier_obligations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monitoring_and_compliance_control_required",
        "result_recording_required",
        "information_accessibility_required",
        "non_compliance_actions",
        "article"
      ],
      "properties": {
        "monitoring_and_compliance_control_required": {
          "const": true
        },
        "result_recording_required": {
          "const": true
        },
        "information_accessibility_required": {
          "const": true
        },
        "non_compliance_actions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 15
          }
        },
        "article": {
          "const": "1(6)-(7)"
        }
      }
    },
    "routine_monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organoleptic",
        "microbiological",
        "chemical",
        "article"
      ],
      "properties": {
        "organoleptic": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "microbiological": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "chemical": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "string"
          }
        },
        "article": {
          "const": "3(9)"
        }
      }
    },
    "repeat_sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "action",
        "article"
      ],
      "properties": {
        "trigger": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "action": {
          "type": "string",
          "minLength": 80
        },
        "article": {
          "const": "3(6)"
        }
      }
    },
    "emergency_monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triggers",
        "action",
        "article"
      ],
      "properties": {
        "triggers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "flood",
              "emergency"
            ]
          }
        },
        "action": {
          "type": "string",
          "minLength": 80
        },
        "article": {
          "const": "3(4)"
        }
      }
    },
    "independent_testing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "article"
      ],
      "properties": {
        "requirement": {
          "type": "string",
          "minLength": 80
        },
        "article": {
          "const": "4(2)"
        }
      }
    },
    "transition_note": {
      "type": "string",
      "minLength": 100
    },
    "interpretation_limits": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 40
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "personal_data_included",
        "business_identifiers_included",
        "exact_site_coordinates_included",
        "raw_sample_records_included",
        "restricted_archive_bytes_included"
      ],
      "properties": {
        "personal_data_included": {
          "const": false
        },
        "business_identifiers_included": {
          "const": false
        },
        "exact_site_coordinates_included": {
          "const": false
        },
        "raw_sample_records_included": {
          "const": false
        },
        "restricted_archive_bytes_included": {
          "const": false
        }
      }
    },
    "legal_transition_review_required": {
      "const": true
    },
    "sampling_frequency_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "article",
        "groundwater_distribution",
        "surface_water_distribution",
        "process_parameters",
        "special_case"
      ],
      "properties": {
        "article": {
          "const": "3(2)-(3), Table 7"
        },
        "groundwater_distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "population_categories",
            "annual_minimum_samples"
          ],
          "properties": {
            "population_categories": {
              "const": [
                "up_to_20000",
                "20000_to_100000",
                "over_100000"
              ]
            },
            "annual_minimum_samples": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "microbiological",
                "organoleptic",
                "general_indicators",
                "inorganic_organic",
                "radiological"
              ],
              "properties": {
                "microbiological": {
                  "const": [
                    12,
                    24,
                    365
                  ]
                },
                "organoleptic": {
                  "const": [
                    12,
                    24,
                    365
                  ]
                },
                "general_indicators": {
                  "const": [
                    4,
                    6,
                    12
                  ]
                },
                "inorganic_organic": {
                  "const": [
                    1,
                    1,
                    1
                  ]
                },
                "radiological": {
                  "const": [
                    1,
                    1,
                    1
                  ]
                }
              }
            }
          }
        },
        "surface_water_distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "population_categories",
            "annual_minimum_samples"
          ],
          "properties": {
            "population_categories": {
              "const": [
                "up_to_100000",
                "over_100000"
              ]
            },
            "annual_minimum_samples": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "microbiological",
                "organoleptic",
                "general_indicators",
                "inorganic_organic",
                "radiological"
              ],
              "properties": {
                "microbiological": {
                  "const": [
                    365,
                    365
                  ]
                },
                "organoleptic": {
                  "const": [
                    365,
                    365
                  ]
                },
                "general_indicators": {
                  "const": [
                    12,
                    24
                  ]
                },
                "inorganic_organic": {
                  "const": [
                    4,
                    12
                  ]
                },
                "radiological": {
                  "const": [
                    1,
                    1
                  ]
                }
              }
            }
          }
        },
        "process_parameters": {
          "type": "string",
          "minLength": 70
        },
        "special_case": {
          "type": "string",
          "minLength": 80
        }
      }
    }
  }
}
