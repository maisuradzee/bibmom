{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AquaSignal public-source access evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "accessed_at", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "const": "AquaSignal" },
    "accessed_at": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "locator", "claim", "status"],
      "properties": {
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "locator": { "type": "string", "minLength": 3 },
        "claim": { "type": "string", "minLength": 10 },
        "status": { "enum": ["FACT", "INFERENCE", "HYPOTHESIS", "UNTESTED IDEA"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "authority", "source_kind", "source_url",
        "catalog_visibility", "catalog_cost", "portal_product_url",
        "linked_resource_url", "payload_status", "payload_sha256",
        "schema_status", "schema_sha256", "reuse_terms_status",
        "reuse_evidence", "sample_level_status", "authorization_status",
        "evidence", "expected_access_state"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 3 },
        "authority": { "type": "string", "minLength": 3 },
        "source_kind": { "enum": ["catalog_record", "report_archive", "dataset_endpoint"] },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "catalog_record_id": { "type": ["string", "null"] },
        "catalog_record_date": { "type": ["string", "null"], "format": "date" },
        "catalog_visibility": { "enum": ["public", "restricted", "not_listed", "unknown"] },
        "catalog_cost": { "enum": ["free", "paid", "unknown"] },
        "geometry_type": { "type": ["string", "null"] },
        "technical_layer": { "type": ["string", "null"] },
        "storage_location": { "type": ["string", "null"] },
        "portal_product_url": { "type": ["string", "null"], "format": "uri" },
        "linked_resource_url": { "type": ["string", "null"], "format": "uri" },
        "payload_status": { "enum": ["not_retrieved", "link_announced_not_retrieved", "retrieved"] },
        "payload_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "schema_status": { "enum": ["not_inspected", "inspected"] },
        "schema_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "reuse_terms_status": { "enum": ["not_verified", "public_license_verified", "written_permission_verified", "restricted"] },
        "reuse_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "sample_level_status": { "enum": ["unknown", "not_present", "available"] },
        "authorization_status": { "enum": ["not_obtained", "granted", "not_required"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "expected_access_state": {
          "enum": [
            "BLOCKED_RESTRICTED",
            "CATALOG_METADATA_ONLY",
            "PAYLOAD_RETRIEVED_SCHEMA_UNINSPECTED",
            "REUSE_UNVERIFIED",
            "NO_SAMPLE_LEVEL_DATA",
            "AUTHORIZATION_REQUIRED",
            "CONTROLLED_INGESTION_ELIGIBLE"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "payload_status": { "const": "retrieved" } }, "required": ["payload_status"] },
          "then": { "properties": { "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
          "else": { "properties": { "payload_sha256": { "type": "null" } } }
        },
        {
          "if": { "properties": { "schema_status": { "const": "inspected" } }, "required": ["schema_status"] },
          "then": {
            "properties": {
              "payload_status": { "const": "retrieved" },
              "schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "else": { "properties": { "schema_sha256": { "type": "null" } } }
        },
        {
          "if": { "properties": { "sample_level_status": { "const": "available" } }, "required": ["sample_level_status"] },
          "then": { "properties": { "schema_status": { "const": "inspected" } } }
        }
      ]
    }
  }
}
