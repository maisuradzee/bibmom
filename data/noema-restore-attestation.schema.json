{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA restore-drill attestation metadata contract",
  "description": "Closed, non-secret checklist metadata. It does not authenticate evidence, decrypt backups, contact a provider or prove a clean-host restore.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "drill_id",
    "created_at_utc",
    "application_commit",
    "execution_scope",
    "checks",
    "measurements",
    "approval",
    "trust",
    "evidence",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "drill_id": {
      "type": "string",
      "pattern": "^drill_[0-9a-f]{16}$"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "application_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "execution_scope": {
      "enum": [
        "same_host_local",
        "offsite_clean_host"
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_integrity_valid",
        "restored_integrity_valid",
        "source_bytes_unchanged",
        "job_count_match",
        "audit_count_match",
        "audit_hash_match",
        "manifest_signature_valid",
        "ciphertext_digest_valid",
        "decryption_valid",
        "plaintext_digest_valid",
        "provider_object_version_verified",
        "retention_attestation_verified",
        "external_high_water_verified",
        "clean_host_verified",
        "service_health_verified"
      ],
      "properties": {
        "source_integrity_valid": {
          "type": "boolean"
        },
        "restored_integrity_valid": {
          "type": "boolean"
        },
        "source_bytes_unchanged": {
          "type": "boolean"
        },
        "job_count_match": {
          "type": "boolean"
        },
        "audit_count_match": {
          "type": "boolean"
        },
        "audit_hash_match": {
          "type": "boolean"
        },
        "manifest_signature_valid": {
          "type": "boolean"
        },
        "ciphertext_digest_valid": {
          "type": "boolean"
        },
        "decryption_valid": {
          "type": "boolean"
        },
        "plaintext_digest_valid": {
          "type": "boolean"
        },
        "provider_object_version_verified": {
          "type": "boolean"
        },
        "retention_attestation_verified": {
          "type": "boolean"
        },
        "external_high_water_verified": {
          "type": "boolean"
        },
        "clean_host_verified": {
          "type": "boolean"
        },
        "service_health_verified": {
          "type": "boolean"
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "restore_duration_seconds",
        "data_loss_seconds",
        "rpo_target_seconds",
        "rto_target_seconds"
      ],
      "properties": {
        "restore_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "data_loss_seconds": {
          "type": "number",
          "minimum": 0
        },
        "rpo_target_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "rto_target_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "policy_id"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "policy_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_version_id",
        "retention_policy_id",
        "high_water_authority_id",
        "high_water_generation_before",
        "restored_backup_generation",
        "high_water_generation_after",
        "clean_host_attestation_id"
      ],
      "properties": {
        "object_version_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "retention_policy_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "high_water_authority_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "high_water_generation_before": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "restored_backup_generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "high_water_generation_after": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "clean_host_attestation_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "sha256",
          "issuer_key_id",
          "signature_verified"
        ],
        "properties": {
          "kind": {
            "enum": [
              "local_source_integrity",
              "local_restore_result",
              "manifest_signature",
              "ciphertext_digest",
              "decryption_result",
              "plaintext_digest",
              "provider_object_version",
              "retention_attestation",
              "external_high_water",
              "clean_host",
              "service_health",
              "rpo_rto_approval"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "issuer_key_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "signature_verified": {
            "type": "boolean"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 20,
        "maxLength": 700
      }
    }
  }
}
