{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AquaSignal signed event-chain checkpoint payload",
  "description": "Strict public metadata only. The detached Ed25519 signature and rollback-resistant high-water state are held outside this document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "store_id",
    "sequence",
    "created_at_utc",
    "event_count",
    "last_hash",
    "signature_format",
    "signing_key_id"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "store_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "created_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "event_count": { "type": "integer", "minimum": 0 },
    "last_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature_format": { "const": "ed25519-raw" },
    "signing_key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
  }
}
