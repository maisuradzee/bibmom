{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA Research Portfolio",
  "type": "object",
  "required": [
    "project",
    "schema_version",
    "updated_at",
    "streams"
  ],
  "additionalProperties": false,
  "properties": {
    "project": {
      "const": "NOEMA"
    },
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "streams": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "pillars",
          "stage",
          "problem",
          "research_question",
          "human_benefit",
          "hypothesis",
          "methodology",
          "sources",
          "data_needs",
          "risks",
          "blockers",
          "status",
          "status_detail",
          "next_step",
          "success_metrics",
          "last_reviewed"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^NOEMA-(2026-[0-9]{3}|INFRA-[0-9]{3})$"
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "pillars": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "DISCOVERY",
                "RESEARCH",
                "INNOVATION"
              ]
            }
          },
          "stage": {
            "enum": [
              "draft",
              "prototype",
              "preliminary",
              "engineering",
              "paused",
              "completed"
            ]
          },
          "problem": {
            "type": "string",
            "minLength": 20
          },
          "research_question": {
            "type": "string",
            "minLength": 20
          },
          "human_benefit": {
            "type": "string",
            "minLength": 15
          },
          "hypothesis": {
            "type": "string",
            "minLength": 15
          },
          "methodology": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "title",
                "publisher",
                "publication_date",
                "url",
                "type",
                "accessed_at"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 3
                },
                "publisher": {
                  "type": "string",
                  "minLength": 2
                },
                "publication_date": {
                  "type": "string",
                  "minLength": 4,
                  "pattern": "^(undated|[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?)$"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "type": {
                  "type": "string",
                  "minLength": 3
                },
                "accessed_at": {
                  "type": "string",
                  "format": "date"
                },
                "note": {
                  "type": "string",
                  "maxLength": 2000
                }
              }
            }
          },
          "data_needs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "risks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "status": {
            "enum": [
              "active",
              "paused",
              "completed"
            ]
          },
          "status_detail": {
            "type": "string",
            "minLength": 10
          },
          "next_step": {
            "type": "string",
            "minLength": 10
          },
          "success_metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "last_reviewed": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
