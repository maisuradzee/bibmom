{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA public research catalogue",
  "type": "object",
  "required": [
    "project",
    "schema_version",
    "research"
  ],
  "additionalProperties": false,
  "properties": {
    "project": {
      "const": "NOEMA"
    },
    "schema_version": {
      "const": 2
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "research": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "date",
          "category",
          "summary",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^NOEMA-[0-9]{4}-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "category": {
            "type": "string",
            "minLength": 2
          },
          "summary": {
            "type": "string",
            "minLength": 20
          },
          "file": {
            "type": "string",
            "pattern": "^research/(preprints|published)/[A-Za-z0-9._-]+\\.md$"
          },
          "status": {
            "enum": [
              "preliminary",
              "published"
            ]
          },
          "version": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "authors",
                "citation",
                "url",
                "type",
                "publication_date",
                "accessed_at"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 3
                },
                "authors": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "citation": {
                  "type": "string",
                  "minLength": 10
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "type": {
                  "type": "string",
                  "minLength": 3
                },
                "publication_date": {
                  "type": "string",
                  "pattern": "^(?:\\\\d{4}(-\\\\d{2}(-\\\\d{2})?)?|undated)$"
                },
                "publication_note": {
                  "type": "string",
                  "minLength": 10
                },
                "accessed_at": {
                  "type": "string",
                  "format": "date"
                },
                "version": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "if": {
                "properties": {
                  "publication_date": {
                    "const": "undated"
                  }
                },
                "required": [
                  "publication_date"
                ]
              },
              "then": {
                "required": [
                  "publication_note"
                ]
              }
            }
          },
          "methodology": {
            "type": "object"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string",
            "format": "uri-reference"
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "file"
            ]
          },
          {
            "required": [
              "url"
            ]
          }
        ]
      }
    }
  }
}
