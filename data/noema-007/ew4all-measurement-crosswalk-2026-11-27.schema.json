{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA-007 EW4All measurement crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_on",
    "project",
    "evidence_boundary",
    "sources",
    "context_signals",
    "mappings",
    "measurement_rules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "project": {
      "const": "NOEMA-2026-007"
    },
    "evidence_boundary": {
      "type": "string",
      "minLength": 30
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "publisher",
          "publication_date",
          "url",
          "type",
          "accessed_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,80}$"
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "publisher": {
            "type": "string",
            "minLength": 2
          },
          "publication_date": {
            "type": "string",
            "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "type": "string",
            "minLength": 3
          },
          "accessed_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "context_signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "source_id",
          "evidence_status",
          "used_as_quantitative_baseline",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,80}$"
          },
          "claim": {
            "type": "string",
            "minLength": 30
          },
          "source_id": {
            "type": "string",
            "minLength": 3
          },
          "evidence_status": {
            "enum": [
              "source_reported_statement_method_not_verified",
              "source_reported_report_finding"
            ]
          },
          "used_as_quantitative_baseline": {
            "const": false
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 15
            }
          }
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "official_indicator",
          "source_id",
          "pillar",
          "unit",
          "denominator_unit",
          "current_noema_measure",
          "alignment",
          "gap",
          "proposed_measurement",
          "interpretation_boundary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9.\\-]{2,20}$"
          },
          "official_indicator": {
            "type": "string",
            "minLength": 20
          },
          "source_id": {
            "type": "string",
            "minLength": 3
          },
          "pillar": {
            "enum": [
              "risk_knowledge",
              "detection_and_forecasting",
              "warning_dissemination_and_communication",
              "preparedness_and_response",
              "cross_pillar_impact"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 5
          },
          "denominator_unit": {
            "type": "string",
            "minLength": 5
          },
          "current_noema_measure": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "alignment": {
            "enum": [
              "full",
              "partial",
              "not_equivalent",
              "not_implemented"
            ]
          },
          "gap": {
            "type": "string",
            "minLength": 20
          },
          "proposed_measurement": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 15
            }
          },
          "interpretation_boundary": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "measurement_rules": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,64}$"
          },
          "rule": {
            "type": "string",
            "minLength": 30
          },
          "reason": {
            "type": "string",
            "minLength": 15
          }
        }
      }
    }
  }
}
