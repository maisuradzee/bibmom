{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA-007 global MHEWS 2026 source snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "research_id", "scope", "source", "facts",
    "supporting_sources", "derived_results", "country_specific_values",
    "causal_effect_established"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "research_id": { "const": "NOEMA-2026-007" },
    "scope": { "const": "global" },
    "source": { "$ref": "#/$defs/source" },
    "facts": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/fact" }
    },
    "supporting_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "derived_results": { "type": "array", "items": { "type": "object" } },
    "country_specific_values": { "type": "array", "maxItems": 0 },
    "causal_effect_established": { "const": false }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "publisher", "publication_date", "url", "accessed_at"],
      "properties": {
        "title": { "type": "string", "minLength": 5 },
        "publisher": { "type": "string", "minLength": 3 },
        "publication_date": { "type": "string", "minLength": 4 },
        "reference_cutoff": { "type": "string" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "accessed_at": { "type": "string", "format": "date" },
        "claim": { "type": "string" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "value", "comparator", "unit", "denominator",
        "status", "interpretation", "limitation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "value": { "type": ["number", "null"] },
        "comparator": { "enum": ["equal", "less_than", "increase", "qualitative"] },
        "unit": { "type": "string", "minLength": 2 },
        "denominator": { "type": ["string", "null"] },
        "status": { "const": "FACT" },
        "interpretation": { "type": "string", "minLength": 15 },
        "limitation": { "type": "string", "minLength": 15 }
      }
    }
  }
}
