{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA-007 WRP 2025 independent aggregate result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "experiment_id",
    "evidence_status",
    "source",
    "sample",
    "warning",
    "action",
    "georgia",
    "methodology",
    "privacy",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "const": "NOEMA-2026-007"
    },
    "experiment_id": {
      "const": "NOEMA-2026-007-WRP2025-WARNING-ACTION-REPRO-001"
    },
    "evidence_status": {
      "const": "REPRODUCED_RESULT"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "path",
        "git_blob_sha1",
        "byte_length",
        "sha256",
        "license"
      ],
      "properties": {
        "repository": {
          "const": "lrfoundation/world_risk_poll_data"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "const": "WRP_2025/WRP_2025.parquet"
        },
        "git_blob_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "byte_length": {
          "const": 7070416
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license": {
          "const": "CC BY-SA 4.0"
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "respondents",
        "countries_and_territories"
      ],
      "properties": {
        "respondents": {
          "const": 143459
        },
        "countries_and_territories": {
          "const": 140
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asked_n",
        "warned_n",
        "not_warned_n",
        "weighted_received_pct"
      ],
      "properties": {
        "asked_n": {
          "const": 24249
        },
        "warned_n": {
          "const": 16996
        },
        "not_warned_n": {
          "const": 7253
        },
        "weighted_received_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asked_n",
        "able_n",
        "unable_n",
        "dk_refused_n",
        "weighted_able_pct",
        "weighted_unable_pct",
        "weighted_dk_refused_pct"
      ],
      "properties": {
        "asked_n": {
          "const": 16996
        },
        "able_n": {
          "const": 9479
        },
        "unable_n": {
          "const": 7383
        },
        "dk_refused_n": {
          "const": 134
        },
        "weighted_able_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "weighted_unable_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "weighted_dk_refused_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "georgia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "impacted_n",
        "warning_question_base_n",
        "country_ranking_minimum_base_n",
        "eligible_for_country_ranking"
      ],
      "properties": {
        "impacted_n": {
          "const": 101
        },
        "warning_question_base_n": {
          "const": 99
        },
        "country_ranking_minimum_base_n": {
          "const": 100
        },
        "eligible_for_country_ranking": {
          "const": false
        }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
