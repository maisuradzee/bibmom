{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA-007 WRP 2025 reproduction protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "experiment_id",
    "evidence_status",
    "source",
    "variables",
    "publisher_reference",
    "method",
    "privacy",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "const": "NOEMA-2026-007"
    },
    "experiment_id": {
      "const": "NOEMA-2026-007-WRP2025-WARNING-ACTION-REPRO-001"
    },
    "evidence_status": {
      "const": "REPRODUCED_RESULT"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "path",
        "git_blob_sha1",
        "byte_length",
        "license",
        "raw_url",
        "dictionary_blob_sha1",
        "publisher_reproduction_blob_sha1"
      ],
      "properties": {
        "repository": {
          "const": "lrfoundation/world_risk_poll_data"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "const": "WRP_2025/WRP_2025.parquet"
        },
        "git_blob_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "license": {
          "const": "CC BY-SA 4.0"
        },
        "raw_url": {
          "type": "string",
          "format": "uri"
        },
        "dictionary_blob_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "publisher_reproduction_blob_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weight",
        "country",
        "impacted",
        "warning_channels",
        "ability_to_act"
      ],
      "properties": {
        "weight": {
          "const": "PROJWT"
        },
        "country": {
          "const": "COUNTRY_ISO3"
        },
        "impacted": {
          "const": "WP24213"
        },
        "warning_channels": {
          "const": [
            "WP24181",
            "WP24182",
            "WP24183",
            "WP24184",
            "WP24185",
            "WP24186",
            "WP24187",
            "WP24188"
          ]
        },
        "ability_to_act": {
          "const": "WP24215"
        }
      }
    },
    "publisher_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "respondents_total",
        "countries_and_territories",
        "warning_question_base",
        "warned_respondents_action_base",
        "weighted_warning_receipt_percent",
        "weighted_able_to_act_percent",
        "weighted_unable_to_act_percent",
        "weighted_action_dk_refused_percent",
        "georgia_impacted_base",
        "georgia_warning_question_base",
        "country_ranking_minimum_base"
      ],
      "properties": {
        "respondents_total": {
          "const": 143459
        },
        "countries_and_territories": {
          "const": 140
        },
        "warning_question_base": {
          "const": 24249
        },
        "warned_respondents_action_base": {
          "const": 16996
        },
        "weighted_warning_receipt_percent": {
          "const": 80
        },
        "weighted_able_to_act_percent": {
          "const": 63.8
        },
        "weighted_unable_to_act_percent": {
          "const": 35.8
        },
        "weighted_action_dk_refused_percent": {
          "const": 0.5
        },
        "georgia_impacted_base": {
          "const": 101
        },
        "georgia_warning_question_base": {
          "const": 99
        },
        "country_ranking_minimum_base": {
          "const": 100
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 4
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_microdata_committed",
        "respondent_ids_committed",
        "workflow_uploads_aggregate_only"
      ],
      "properties": {
        "raw_microdata_committed": {
          "const": false
        },
        "respondent_ids_committed": {
          "const": false
        },
        "workflow_uploads_aggregate_only": {
          "const": true
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 20
      }
    }
  }
}
