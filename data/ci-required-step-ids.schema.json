{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA CI required step ID manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "required_step_ids",
    "prerequisite_step_ids",
    "validation_step_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "required_step_ids": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{1,63}$"
      }
    },
    "prerequisite_step_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{1,63}$"
      }
    },
    "validation_step_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{1,63}$"
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "required_step_ids": {
          "contains": {
            "const": "checkout"
          }
        }
      }
    },
    {
      "properties": {
        "required_step_ids": {
          "contains": {
            "const": "dependencies"
          }
        }
      }
    }
  ]
}
