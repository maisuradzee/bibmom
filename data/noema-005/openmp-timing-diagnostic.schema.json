{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA-005 OpenMP per-thread timing and affinity diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "experiment_id",
    "status",
    "captured_at_utc",
    "source_sha256",
    "compiler_version",
    "compile_flags",
    "parameters",
    "environment",
    "runs",
    "summary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "study_id": {
      "const": "NOEMA-2026-005"
    },
    "experiment_id": {
      "const": "NOEMA-2026-005-OPENMP-TIMING-DIAG-001"
    },
    "status": {
      "enum": [
        "completed_no_cpu_wall_anomalies",
        "completed_with_cpu_wall_anomalies"
      ]
    },
    "captured_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compiler_version": {
      "type": "string",
      "minLength": 5
    },
    "compile_flags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workers",
        "repetitions",
        "warmups",
        "work_items"
      ],
      "properties": {
        "workers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "warmups": {
          "const": 1
        },
        "work_items": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cgroup_v2_detected",
        "cgroup_membership_resolved",
        "cgroup_cpuset_cpus_effective",
        "cgroup_cpu_max",
        "cgroup_cpu_quota_cores",
        "process_affinity_cpus",
        "process_affinity_count",
        "cpu_stat_before",
        "cpu_stat_after",
        "cpu_stat_delta",
        "machine_architecture",
        "kernel_release",
        "python_version",
        "openmp_environment"
      ],
      "properties": {
        "cgroup_v2_detected": {
          "type": "boolean"
        },
        "cgroup_membership_resolved": {
          "type": "boolean"
        },
        "cgroup_cpuset_cpus_effective": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "cgroup_cpu_max": {
          "type": [
            "string",
            "null"
          ]
        },
        "cgroup_cpu_quota_cores": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "process_affinity_cpus": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "process_affinity_count": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_stat_before": {
          "$ref": "#/$defs/cpuStat"
        },
        "cpu_stat_after": {
          "$ref": "#/$defs/cpuStat"
        },
        "cpu_stat_delta": {
          "$ref": "#/$defs/cpuStat"
        },
        "machine_architecture": {
          "type": "string"
        },
        "kernel_release": {
          "type": "string"
        },
        "python_version": {
          "type": "string"
        },
        "openmp_environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "OMP_NUM_THREADS": {
              "type": [
                "string",
                "null"
              ]
            },
            "OMP_DYNAMIC": {
              "type": [
                "string",
                "null"
              ]
            },
            "OMP_PROC_BIND": {
              "type": [
                "string",
                "null"
              ]
            },
            "OMP_PLACES": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "cgroup_cpu_quota_ancestor_levels": {
          "type": "integer",
          "minimum": 0
        },
        "cgroup_cpu_quota_constrained_levels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "cgroup_cpu_quota_chain_complete": {
          "type": "boolean"
        },
        "cgroup_cpu_quota_unreadable_level_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_count",
        "cpu_wall_anomaly_count",
        "max_process_cpu_wall_ratio",
        "per_worker"
      ],
      "properties": {
        "run_count": {
          "type": "integer",
          "minimum": 1
        },
        "cpu_wall_anomaly_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_process_cpu_wall_ratio": {
          "type": "number",
          "minimum": 0
        },
        "per_worker": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requested_workers",
              "median_process_cpu_wall_ratio",
              "anomaly_count"
            ],
            "properties": {
              "requested_workers": {
                "type": "integer",
                "minimum": 1
              },
              "median_process_cpu_wall_ratio": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "anomaly_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "thread_cgroup_mismatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "thread_cgroup_unverified_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  },
  "$defs": {
    "cpuStat": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thread_index",
        "cpu_ns",
        "rusage_thread_ns",
        "affinity_cpu_count",
        "affinity_cpus",
        "cpu_start",
        "cpu_end",
        "checksum"
      ],
      "properties": {
        "thread_index": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_ns": {
          "type": "integer",
          "minimum": 0
        },
        "rusage_thread_ns": {
          "type": "integer",
          "minimum": 0
        },
        "affinity_cpu_count": {
          "type": "integer",
          "minimum": 1
        },
        "affinity_cpus": {
          "type": "string",
          "minLength": 1
        },
        "cpu_start": {
          "type": "integer",
          "minimum": -1
        },
        "cpu_end": {
          "type": "integer",
          "minimum": -1
        },
        "checksum": {
          "type": "number"
        },
        "thread_cgroup_matches_process": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_workers",
        "actual_threads",
        "repetition",
        "work_items",
        "wall_ns",
        "process_cpu_ns",
        "omp_wall_ns",
        "process_cpu_wall_ratio",
        "thread_cpu_sum_ns",
        "checksum",
        "threads",
        "observed_affinity_union_cpus",
        "observed_affinity_union_count",
        "effective_cpu_capacity",
        "cpu_wall_anomaly_threshold",
        "cpu_wall_anomaly",
        "thread_cpu_sum_to_process_cpu_ratio"
      ],
      "properties": {
        "requested_workers": {
          "type": "integer",
          "minimum": 1
        },
        "actual_threads": {
          "type": "integer",
          "minimum": 1
        },
        "repetition": {
          "type": "integer",
          "minimum": 1
        },
        "work_items": {
          "type": "integer",
          "minimum": 1
        },
        "wall_ns": {
          "type": "integer",
          "minimum": 1
        },
        "process_cpu_ns": {
          "type": "integer",
          "minimum": 1
        },
        "omp_wall_ns": {
          "type": "integer",
          "minimum": 1
        },
        "process_cpu_wall_ratio": {
          "type": "number",
          "minimum": 0
        },
        "thread_cpu_sum_ns": {
          "type": "integer",
          "minimum": 0
        },
        "checksum": {
          "type": "number"
        },
        "threads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/thread"
          }
        },
        "observed_affinity_union_cpus": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "observed_affinity_union_count": {
          "type": "integer",
          "minimum": 0
        },
        "effective_cpu_capacity": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "cpu_wall_anomaly_threshold": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "cpu_wall_anomaly": {
          "type": "boolean"
        },
        "thread_cpu_sum_to_process_cpu_ratio": {
          "type": "number",
          "minimum": 0
        },
        "thread_cgroup_mismatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "thread_cgroup_unverified_count": {
          "type": "integer",
          "minimum": 0
        },
        "process_thread_count": {
          "type": "integer",
          "minimum": -1
        },
        "known_cpu_capacity_upper_bound": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "cpu_wall_anomaly_threshold_basis": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "full_cgroup_quota_chain",
            "affinity_cpuset_upper_bound",
            null
          ]
        }
      }
    }
  }
}
