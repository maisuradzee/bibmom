{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA-005 final hosted raw-report archive manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "experiment_id",
    "date",
    "evidence_status",
    "workflow_run",
    "bundle",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "const": "NOEMA-2026-005"
    },
    "experiment_id": {
      "const": "NOEMA-2026-005-REAL-THREADS-001"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "evidence_status": {
      "const": "REPRODUCED_RESULT"
    },
    "workflow_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "tested_head_sha",
        "artifact_expiry"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "tested_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_expiry": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "encoding",
        "compressed_sha256",
        "uncompressed_sha256",
        "uncompressed_bytes",
        "reports"
      ],
      "properties": {
        "path": {
          "const": "data/noema-005/raw/run-45911409646-reports.json.xz.b64"
        },
        "encoding": {
          "const": "base64(xz JSON object keyed by run_id:runtime_mode)"
        },
        "compressed_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "uncompressed_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "uncompressed_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "reports": {
          "const": 2
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "name",
          "runtime_mode",
          "zip_bytes",
          "zip_sha256",
          "report_sha256",
          "report_bytes",
          "platform",
          "python_version",
          "machine",
          "cpu_affinity_count",
          "accuracy",
          "native_thread_count_matches_worker_count"
        ],
        "properties": {
          "artifact_id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 5
          },
          "runtime_mode": {
            "enum": [
              "gil-enabled",
              "free-threaded"
            ]
          },
          "zip_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "zip_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "report_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "report_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "platform": {
            "type": "string",
            "minLength": 5
          },
          "python_version": {
            "const": "3.14.4"
          },
          "machine": {
            "const": "x86_64"
          },
          "cpu_affinity_count": {
            "const": 4
          },
          "accuracy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "threaded_naive_scalar",
              "threaded_neumaier_scalar",
              "threaded_neumaier_state"
            ],
            "properties": {
              "threaded_naive_scalar": {
                "const": "0/48"
              },
              "threaded_neumaier_scalar": {
                "const": "42/48"
              },
              "threaded_neumaier_state": {
                "const": "48/48"
              }
            }
          },
          "native_thread_count_matches_worker_count": {
            "const": true
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  }
}
