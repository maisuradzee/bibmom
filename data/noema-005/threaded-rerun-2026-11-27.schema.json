{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA-005 real CPU-thread rerun summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "experiment_id",
    "date",
    "status",
    "evidence_status",
    "workflow_run",
    "artifacts",
    "inputs",
    "protocol",
    "environments",
    "aggregates",
    "serial_math_fsum_comparison",
    "findings",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "const": "NOEMA-2026-005"
    },
    "experiment_id": {
      "const": "NOEMA-2026-005-REAL-THREADS-001"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "preliminary"
    },
    "evidence_status": {
      "const": "REPRODUCED_RESULT"
    },
    "workflow_run": {
      "type": "object",
      "required": [
        "id",
        "url",
        "tested_head_sha",
        "generated_at_utc"
      ],
      "properties": {
        "id": {
          "const": 45897707859
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "tested_head_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "generated_at_utc": {
          "type": "object",
          "required": [
            "free_threaded",
            "gil_enabled"
          ]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "free_threaded",
        "gil_enabled"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 2
    },
    "protocol": {
      "type": "object",
      "required": [
        "workers",
        "partitions",
        "methods",
        "warmups",
        "repetitions",
        "cases_per_runtime",
        "runs_per_runtime"
      ]
    },
    "environments": {
      "type": "object",
      "required": [
        "free_threaded",
        "gil_enabled"
      ]
    },
    "aggregates": {
      "type": "object",
      "required": [
        "free_threaded",
        "gil_enabled"
      ],
      "properties": {
        "free_threaded": {
          "type": "object"
        },
        "gil_enabled": {
          "type": "object"
        }
      }
    },
    "serial_math_fsum_comparison": {
      "type": "object",
      "required": [
        "free_threaded",
        "gil_enabled"
      ]
    },
    "findings": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 20
      }
    }
  }
}
