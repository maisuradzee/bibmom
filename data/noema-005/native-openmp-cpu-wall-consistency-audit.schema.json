{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA-005 native OpenMP CPU/wall consistency audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "study_id",
    "audit_id",
    "source_summary_git_blob_sha",
    "source_raw_git_blob_sha",
    "source_workflow_run_id",
    "reported_cpu_count",
    "effective_cpuset",
    "effective_cpuset_cpu_count",
    "anomaly_threshold_ratio",
    "openmp_case_count",
    "outlier_measurement_count",
    "flagged_case_count",
    "max_observed_process_cpu_to_wall_ratio",
    "outliers",
    "accuracy",
    "median_speedups",
    "interpretation",
    "limitations"
  ],
  "properties": {
    "study_id": {
      "const": "NOEMA-2026-005"
    },
    "audit_id": {
      "type": "string"
    },
    "source_summary_git_blob_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_raw_git_blob_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_workflow_run_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "reported_cpu_count": {
      "type": "integer",
      "minimum": 1
    },
    "effective_cpuset": {
      "type": "string"
    },
    "effective_cpuset_cpu_count": {
      "type": "integer",
      "minimum": 1
    },
    "anomaly_threshold_ratio": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "openmp_case_count": {
      "type": "integer",
      "minimum": 1
    },
    "outlier_measurement_count": {
      "type": "integer",
      "minimum": 0
    },
    "flagged_case_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_observed_process_cpu_to_wall_ratio": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "outliers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layout",
          "method",
          "workers",
          "repetition",
          "ratio"
        ],
        "properties": {
          "layout": {
            "enum": [
              "triplet_order",
              "grouped_cancellation"
            ]
          },
          "method": {
            "enum": [
              "openmp_naive_partials",
              "openmp_neumaier_state"
            ]
          },
          "workers": {
            "type": "integer",
            "minimum": 1
          },
          "repetition": {
            "type": "integer",
            "minimum": 1
          },
          "ratio": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "accuracy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openmp_neumaier_correct_runs",
        "openmp_naive_correct_runs",
        "openmp_neumaier_expected_runs",
        "openmp_naive_expected_runs"
      ],
      "properties": {
        "openmp_neumaier_correct_runs": {
          "type": "integer",
          "minimum": 0
        },
        "openmp_naive_correct_runs": {
          "type": "integer",
          "minimum": 0
        },
        "openmp_neumaier_expected_runs": {
          "type": "integer",
          "minimum": 1
        },
        "openmp_naive_expected_runs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "median_speedups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "layout",
          "method",
          "workers",
          "median_speedup"
        ],
        "properties": {
          "layout": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "workers": {
            "type": "integer"
          },
          "median_speedup": {
            "type": "number"
          }
        }
      }
    },
    "interpretation": {
      "type": "string",
      "minLength": 40
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
