{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA-005 ARM64 worker-scaling analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "experiment_id",
    "analysis_date",
    "source_summary",
    "protocol",
    "accuracy",
    "runner_scaling",
    "interpretation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "const": "NOEMA-2026-005"
    },
    "experiment_id": {
      "const": "NOEMA-2026-005-REAL-THREADS-ARM64-001"
    },
    "analysis_date": {
      "type": "string",
      "format": "date"
    },
    "source_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "git_blob_sha"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "git_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_runtime_cells",
        "threaded_configurations",
        "measured_runs",
        "repetitions_per_configuration",
        "workers",
        "memory_metric",
        "wall_time_baseline"
      ],
      "properties": {
        "runner_runtime_cells": {
          "const": 4
        },
        "threaded_configurations": {
          "const": 192
        },
        "measured_runs": {
          "const": 576
        },
        "repetitions_per_configuration": {
          "const": 3
        },
        "workers": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "memory_metric": {
          "type": "string"
        },
        "wall_time_baseline": {
          "type": "string"
        }
      }
    },
    "accuracy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "naive_scalar",
        "neumaier_scalar",
        "neumaier_state"
      ],
      "properties": {
        "naive_scalar": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correct",
            "total"
          ],
          "properties": {
            "correct": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "const": 192
            }
          }
        },
        "neumaier_scalar": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correct",
            "total"
          ],
          "properties": {
            "correct": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "const": 192
            }
          }
        },
        "neumaier_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correct",
            "total"
          ],
          "properties": {
            "correct": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "const": 192
            }
          }
        }
      }
    },
    "runner_scaling": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runner",
          "runtime_mode",
          "machine",
          "worker_points",
          "peak_traced_python_growth_8_over_1",
          "best_worker_median_speedup",
          "best_worker_count"
        ],
        "properties": {
          "runner": {
            "type": "string"
          },
          "runtime_mode": {
            "enum": [
              "gil-enabled",
              "free-threaded"
            ]
          },
          "machine": {
            "type": "string"
          },
          "worker_points": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "worker_count",
                "median_speedup",
                "median_peak_traced_python_bytes",
                "median_cpu_wall_ratio",
                "correctly_rounded_runs",
                "total_runs"
              ],
              "properties": {
                "worker_count": {
                  "type": "integer"
                },
                "median_speedup": {
                  "type": "number"
                },
                "median_peak_traced_python_bytes": {
                  "type": "integer"
                },
                "median_cpu_wall_ratio": {
                  "type": "number"
                },
                "correctly_rounded_runs": {
                  "const": 12
                },
                "total_runs": {
                  "const": 12
                }
              }
            }
          },
          "peak_traced_python_growth_8_over_1": {
            "type": "number",
            "exclusiveMinimum": 1
          },
          "best_worker_median_speedup": {
            "type": "number"
          },
          "best_worker_count": {
            "type": "integer"
          }
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_runtime_cells_with_any_worker_median_above_one",
        "runner_runtime_cells_total",
        "memory_growth_8_worker_over_1_worker_range",
        "statement"
      ],
      "properties": {
        "runner_runtime_cells_with_any_worker_median_above_one": {
          "const": 2
        },
        "runner_runtime_cells_total": {
          "const": 4
        },
        "memory_growth_8_worker_over_1_worker_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "statement": {
          "type": "string"
        }
      }
    }
  }
}
