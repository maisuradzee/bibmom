{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maisuradzee.github.io/bibmom/schemas/noema005-cross-architecture-run33.schema.json",
  "title": "NOEMA-005 Run 33 cross-architecture aggregate synthesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "experiment_id",
    "date",
    "evidence_status",
    "source_summaries",
    "protocol",
    "input_sha256",
    "protocol_and_input_match",
    "speedup_cells",
    "combined",
    "limitations",
    "validation_scope"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "const": "NOEMA-2026-005"
    },
    "experiment_id": {
      "const": "NOEMA-2026-005-CROSS-ARCH-RUN33-001"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "evidence_status": {
      "const": "REPRODUCED_RESULT"
    },
    "source_summaries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "architecture",
          "source_path",
          "source_blob_sha1",
          "source_commit",
          "source_pull_request",
          "workflow_run_ids",
          "reports",
          "configurations",
          "measured_runs",
          "accuracy",
          "cpu_wall_samples_above_1_05",
          "artifact_zip_digests_recomputed",
          "raw_report_sha256_recorded"
        ],
        "properties": {
          "architecture": {
            "enum": [
              "x86_64",
              "arm64"
            ]
          },
          "source_path": {
            "type": "string"
          },
          "source_blob_sha1": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "source_pull_request": {
            "type": "integer",
            "minimum": 1
          },
          "workflow_run_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "reports": {
            "type": "integer",
            "minimum": 1
          },
          "configurations": {
            "type": "integer",
            "minimum": 1
          },
          "measured_runs": {
            "type": "integer",
            "minimum": 1
          },
          "accuracy": {
            "$ref": "#/$defs/accuracy"
          },
          "cpu_wall_samples_above_1_05": {
            "$ref": "#/$defs/cpuWall"
          },
          "artifact_zip_digests_recomputed": {
            "const": true
          },
          "raw_report_sha256_recorded": {
            "const": true
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "repeat_count",
        "value_count_per_layout",
        "workers",
        "layouts",
        "partitions",
        "methods",
        "warmups",
        "repetitions",
        "reference",
        "cpu_metric",
        "memory_metric"
      ],
      "properties": {
        "python_version": {
          "const": "3.14.4"
        },
        "repeat_count": {
          "const": 65536
        },
        "value_count_per_layout": {
          "const": 196608
        },
        "workers": {
          "const": [
            1,
            2,
            4,
            8
          ]
        },
        "layouts": {
          "const": [
            "triplet_order",
            "grouped_cancellation"
          ]
        },
        "partitions": {
          "const": [
            "contiguous",
            "round_robin"
          ]
        },
        "methods": {
          "const": [
            "threaded_naive_scalar",
            "threaded_neumaier_scalar",
            "threaded_neumaier_state"
          ]
        },
        "warmups": {
          "const": 1
        },
        "repetitions": {
          "const": 3
        },
        "reference": {
          "type": "string"
        },
        "cpu_metric": {
          "type": "string"
        },
        "memory_metric": {
          "type": "string"
        }
      }
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triplet_order",
        "grouped_cancellation"
      ],
      "properties": {
        "triplet_order": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "grouped_cancellation": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "protocol_and_input_match": {
      "const": true
    },
    "speedup_cells": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "architecture",
          "runner",
          "backend",
          "runtime_mode",
          "workflow_run_id",
          "neumaier_state_median_speedup"
        ],
        "properties": {
          "architecture": {
            "enum": [
              "x86_64",
              "arm64"
            ]
          },
          "runner": {
            "type": "string"
          },
          "backend": {
            "type": "string"
          },
          "runtime_mode": {
            "enum": [
              "gil_enabled",
              "free_threaded"
            ]
          },
          "workflow_run_id": {
            "type": "integer",
            "minimum": 1
          },
          "neumaier_state_median_speedup": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "combined": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reports",
        "configurations",
        "measured_runs",
        "accuracy",
        "cpu_wall_samples_above_1_05",
        "neumaier_state_median_speedup_ranges",
        "cells_above_1_0",
        "cells_below_1_0",
        "interpretation"
      ],
      "properties": {
        "reports": {
          "const": 10
        },
        "configurations": {
          "const": 480
        },
        "measured_runs": {
          "const": 1440
        },
        "accuracy": {
          "$ref": "#/$defs/accuracy"
        },
        "cpu_wall_samples_above_1_05": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x86_64",
            "arm64"
          ],
          "properties": {
            "x86_64": {
              "$ref": "#/$defs/cpuWall"
            },
            "arm64": {
              "$ref": "#/$defs/cpuWall"
            }
          }
        },
        "neumaier_state_median_speedup_ranges": {
          "type": "object"
        },
        "cells_above_1_0": {
          "const": 2
        },
        "cells_below_1_0": {
          "const": 8
        },
        "interpretation": {
          "type": "string",
          "minLength": 50
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "validation_scope": {
      "type": "string",
      "minLength": 50
    }
  },
  "$defs": {
    "accuracy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "naive_scalar",
        "neumaier_scalar",
        "neumaier_state"
      ],
      "properties": {
        "naive_scalar": {
          "$ref": "#/$defs/count"
        },
        "neumaier_scalar": {
          "$ref": "#/$defs/count"
        },
        "neumaier_state": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correct",
        "total"
      ],
      "properties": {
        "correct": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cpuWall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gil_enabled",
        "free_threaded"
      ],
      "properties": {
        "gil_enabled": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "total"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "free_threaded": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "total"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
