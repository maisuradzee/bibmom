          "type": "object",
          "additionalProperties": false,
          "required": [
            "naive_scalar",
            "neumaier_scalar",
            "neumaier_state"
          ],
          "properties": {
            "naive_scalar": {
              "type": "string",
              "pattern": "^\\d+/48$"
            },
            "neumaier_scalar": {
              "type": "string",
              "pattern": "^\\d+/48$"
            },
            "neumaier_state": {
              "type": "string",
              "pattern": "^\\d+/48$"
            }
          }
        },
        "median_speedup_by_method": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "naive_scalar",
            "neumaier_scalar",
            "neumaier_state"
          ],
          "properties": {
            "naive_scalar": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "neumaier_scalar": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "neumaier_state": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "neumaier_state_by_worker": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workers",
              "median_speedup",
              "median_cpu_wall_ratio",
              "median_peak_traced_python_bytes",
              "correctly_rounded_runs",
              "total_runs"
            ],
            "properties": {
              "workers": {
                "enum": [
                  1,
                  2,
                  4,
                  8
                ]
              },
              "median_speedup": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "median_cpu_wall_ratio": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "median_peak_traced_python_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "correctly_rounded_runs": {
                "const": 12
              },
              "total_runs": {
                "const": 12
              }
            }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "zip_digest",
            "raw_report_sha256",
            "raw_report_bytes",
            "expires_at"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "zip_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "raw_report_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "raw_report_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
