        "workflow_run_url",
        "quality_run_id",
        "head_sha",
        "runner_label",
        "cloud_backend",
        "runtime_mode",
        "environment",
        "accuracy",
        "cpu_wall_samples_above_1_05",
        "median_speedup_by_method",
        "neumaier_state_by_worker",
