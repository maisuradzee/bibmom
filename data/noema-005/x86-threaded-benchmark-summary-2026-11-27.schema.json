      "properties": {
        "correct": {
          "const": 0
        },
        "total": {
          "const": 192
        }
      }
    },
    "count168": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correct",
        "total"
      ],
      "properties": {
        "correct": {
          "const": 168
        },
        "total": {
          "const": 192
        }
      }
    },
    "count192": {
      "type": "object",
