{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maisuradzee.github.io/bibmom/schemas/noema005-cross-architecture-reduction-manifest.schema.json",
  "title": "NOEMA-005 cross-architecture reduction artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "experiment_id",
    "generated_at_utc",
    "source_commit",
    "artifacts",
    "native_accumulator",
    "native_openmp",
    "python_threads",
    "limitations",
    "validation_test",
    "validation_scope"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "const": "NOEMA-2026-005"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflow",
          "run_id",
          "artifact_id",
          "name",
          "sha256",
          "size_bytes",
          "runner",
          "status"
        ],
        "properties": {
          "workflow": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "integer",
            "minimum": 1
          },
          "artifact_id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "runner": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "success"
          }
        }
      }
    },
    "native_accumulator": {
      "type": "object",
      "required": [
        "source_sha256",
        "compiler",
        "cpus",
        "repetitions",
        "warmups",
        "repeat_count",
        "cases_per_architecture",
        "long_double_mant_dig",
        "process_peak_rss_kib",
        "correctly_rounded_runs",
        "speedup_vs_matching_serial"
      ],
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "compiler": {
          "type": "string"
        },
        "cpus": {
          "type": "integer",
          "minimum": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "warmups": {
          "type": "integer",
          "minimum": 0
        },
        "repeat_count": {
          "type": "integer",
          "minimum": 1
        },
        "cases_per_architecture": {
          "type": "integer",
          "minimum": 1
        },
        "long_double_mant_dig": {
          "type": "object",
          "required": [
            "x86_64",
            "arm64"
          ],
          "properties": {
            "x86_64": {
              "type": "integer"
            },
            "arm64": {
              "type": "integer"
            }
          }
        },
        "process_peak_rss_kib": {
          "type": "object",
          "required": [
            "x86_64",
            "arm64"
          ],
          "properties": {
            "x86_64": {
              "type": "integer"
            },
            "arm64": {
              "type": "integer"
            }
          }
        },
        "correctly_rounded_runs": {
          "type": "object"
        },
        "speedup_vs_matching_serial": {
          "type": "object"
        }
      }
    },
    "native_openmp": {
      "type": "object",
      "required": [
        "cases",
        "repetitions",
        "input_storage_bytes",
        "process_peak_rss_kib",
        "correctly_rounded_runs",
        "speedup_vs_matching_serial"
      ],
      "properties": {
        "cases": {
          "type": "integer",
          "minimum": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "input_storage_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "process_peak_rss_kib": {
          "type": "integer",
          "minimum": 1
        },
        "correctly_rounded_runs": {
          "type": "object"
        },
        "speedup_vs_matching_serial": {
          "type": "object"
        }
      }
    },
    "python_threads": {
      "type": "object",
      "required": [
        "cases_per_environment",
        "repetitions",
        "warmups",
        "repeat_count",
        "value_count_per_layout",
        "cpu_count_process",
        "correctly_rounded_runs",
        "neumaier_state_max_cpu_wall_ratio",
        "neumaier_state_median_speedup",
        "neumaier_state_median_tracemalloc_bytes",
        "gil_enabled",
        "free_threaded"
      ],
      "properties": {
        "cases_per_environment": {
          "type": "integer",
          "minimum": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "warmups": {
          "type": "integer",
          "minimum": 0
        },
        "repeat_count": {
          "type": "integer",
          "minimum": 1
        },
        "value_count_per_layout": {
          "type": "integer",
          "minimum": 1
        },
        "cpu_count_process": {
          "type": "object",
          "required": [
            "macos",
            "ubuntu"
          ],
          "properties": {
            "macos": {
              "type": "integer",
              "minimum": 1
            },
            "ubuntu": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "correctly_rounded_runs": {
          "type": "object"
        },
        "neumaier_state_max_cpu_wall_ratio": {
          "type": "object"
        },
        "neumaier_state_median_speedup": {
          "type": "object"
        },
        "neumaier_state_median_tracemalloc_bytes": {
          "type": "object"
        },
        "gil_enabled": {
          "type": "object"
        },
        "free_threaded": {
          "type": "object"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_test": {
      "type": "string",
      "minLength": 1
    },
    "validation_scope": {
      "type": "string",
      "minLength": 1
    }
  }
}
