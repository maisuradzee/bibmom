{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA-005 actual threaded benchmark archive manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "experiment_id",
    "run",
    "source_code",
    "protocol",
    "normalized_snapshot_policy",
    "runtimes",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "const": "NOEMA-2026-005"
    },
    "experiment_id": {
      "const": "NOEMA-2026-005-REAL-THREADS-001"
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "run_number",
        "name",
        "event",
        "head_sha",
        "head_branch",
        "base_sha",
        "created_at",
        "updated_at",
        "url"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "run_number": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_branch": {
          "type": "string"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "source_code": {
      "type": "object",
      "required": [
        "benchmark_script_path",
        "benchmark_script_git_blob_sha",
        "orchestrator_path",
        "orchestrator_git_blob_sha",
        "workflow_path",
        "workflow_git_blob_sha"
      ],
      "properties": {
        "benchmark_script_path": {
          "type": "string"
        },
        "benchmark_script_git_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "orchestrator_path": {
          "type": "string"
        },
        "orchestrator_git_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflow_path": {
          "type": "string"
        },
        "workflow_git_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "python_version",
        "cases_per_runtime",
        "total_cases",
        "runs_per_case",
        "worker_counts",
        "layouts",
        "partitions",
        "methods",
        "value_count",
        "repeat_count",
        "exact_sum_fraction",
        "inputs"
      ],
      "properties": {
        "python_version": {
          "type": "string"
        },
        "cases_per_runtime": {
          "type": "integer"
        },
        "total_cases": {
          "type": "integer"
        },
        "runs_per_case": {
          "type": "integer"
        },
        "worker_counts": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "layouts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "value_count": {
          "type": "integer"
        },
        "repeat_count": {
          "type": "integer"
        },
        "exact_sum_fraction": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "layout",
              "canonical_binary64_big_endian_sha256"
            ],
            "properties": {
              "layout": {
                "type": "string"
              },
              "canonical_binary64_big_endian_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "normalized_snapshot_policy": {
      "type": "object",
      "required": [
        "description",
        "preserved_fields",
        "omitted_fields",
        "original_artifact_retained_until"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "preserved_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "omitted_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "original_artifact_retained_until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "runtimes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "artifact_id",
          "artifact_name",
          "original_artifact_zip_digest",
          "original_artifact_size_bytes",
          "artifact_expires_at",
          "original_json_filename",
          "original_json_sha256",
          "archive_path",
          "compressed_bytes",
          "compressed_sha256",
          "normalized_json_sha256",
          "environment",
          "metrics"
        ],
        "properties": {
          "id": {
            "enum": [
              "free_threaded",
              "gil_enabled"
            ]
          },
          "artifact_id": {
            "type": "integer"
          },
          "artifact_name": {
            "type": "string"
          },
          "original_artifact_zip_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "original_artifact_size_bytes": {
            "type": "integer"
          },
          "artifact_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "original_json_filename": {
            "type": "string"
          },
          "original_json_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "archive_path": {
            "type": "string"
          },
          "compressed_bytes": {
            "type": "integer"
          },
          "compressed_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "normalized_json_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "environment": {
            "type": "object",
            "required": [
              "python_version",
              "python_implementation",
              "platform",
              "machine",
              "free_threaded_build",
              "gil_enabled",
              "py_gil_disabled_config",
              "cpu_count_os",
              "cpu_count_process",
              "cpu_affinity_count",
              "python_build"
            ],
            "properties": {
              "python_version": {
                "type": "string"
              },
              "python_implementation": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              },
              "machine": {
                "type": "string"
              },
              "free_threaded_build": {
                "type": "boolean"
              },
              "gil_enabled": {
                "type": "boolean"
              },
              "py_gil_disabled_config": {
                "type": "integer"
              },
              "cpu_count_os": {
                "type": "integer"
              },
              "cpu_count_process": {
                "type": "integer"
              },
              "cpu_affinity_count": {
                "type": "integer"
              },
              "python_build": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "metrics": {
            "type": "object",
            "required": [
              "accuracy",
              "best_neumaier_state_speedup",
              "best_neumaier_state_config",
              "best_grouped_neumaier_state_speedup",
              "best_grouped_config",
              "memory_growth_1_to_8",
              "max_neumaier_median_cpu_wall_ratio",
              "parallelism_observed_worker_counts",
              "all_native_thread_counts_match_requested"
            ],
            "properties": {
              "accuracy": {
                "type": "object"
              },
              "best_neumaier_state_speedup": {
                "type": "number"
              },
              "best_neumaier_state_config": {
                "type": "object"
              },
              "best_grouped_neumaier_state_speedup": {
                "type": "number"
              },
              "best_grouped_config": {
                "type": "object"
              },
              "memory_growth_1_to_8": {
                "type": "object"
              },
              "max_neumaier_median_cpu_wall_ratio": {
                "type": "number"
              },
              "parallelism_observed_worker_counts": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "all_native_thread_counts_match_requested": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
