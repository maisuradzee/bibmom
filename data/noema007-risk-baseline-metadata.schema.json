{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOEMA-007 risk-baseline source metadata",
  "description": "Metadata-only contract. It does not validate source contents, authorize reuse, or issue warnings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "source_url",
    "publisher",
    "dataset_reference_date",
    "dataset_updated_date",
    "declared_update_interval_days",
    "retrieved_at_utc",
    "licence_status",
    "source_revision_sha256",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 128 },
    "dataset_reference_date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "dataset_updated_date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "declared_update_interval_days": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 36500
    },
    "retrieved_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "licence_status": {
      "enum": ["unknown", "verified_reuse", "restricted"]
    },
    "source_revision_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5, "maxLength": 500 }
    }
  }
}
