[Unit]
Description=NOEMA autonomous service runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=noema
Group=noema
WorkingDirectory=/opt/noema
StateDirectory=noema
StateDirectoryMode=0750
UMask=0077
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/noema/.venv/bin/python -m noema_core.service --db /var/lib/noema/noema-jobs.sqlite3 --poll-interval 1 --self-check-interval 300
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/noema
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
